    "@aasp/scanner-http": "workspace:*",
    "@aasp/scanner-integrations": "workspace:*",
    "@aasp/scanner-misconfiguration": "workspace:*",
    "@aasp/scanner-tls": "workspace:*",
    "@aasp/schemas": "workspace:*",
